+def _assets_available() -> bool:
+    try:
+        from adapt.dingo_bns_demo import discover_assets
+
+        assets = discover_assets()
+        return Path(assets["baseline_ckpt"]).is_file() and Path(assets["event_hdf5"]).is_file()
+    except Exception:
+        return False
